# Copy these names into the hosting provider's encrypted variables/secrets.
# Never commit real values. Production must not use mock payments or local admin.
APP_ENV=production
APP_BASE_URL=https://YOUR_DOMAIN
CATALOG_SOURCE=database

ADMIN_AUTH_MODE=cloudflare-access
ADMIN_EMAILS=OWNER_EMAIL,OPERATOR_EMAIL
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=YOUR_APPLICATION_AUD_TAG

RAZORPAY_MODE=test
RAZORPAY_KEY_ID=STORE_AS_SECRET
RAZORPAY_KEY_SECRET=STORE_AS_SECRET
RAZORPAY_WEBHOOK_SECRET=STORE_AS_SECRET
ALLOW_MOCK_PAYMENTS=false

SHIPPING_FLAT_RATE_PAISE=9900
FREE_SHIPPING_THRESHOLD_PAISE=199900

EMAIL_MODE=resend
RESEND_API_KEY=STORE_AS_SECRET
EMAIL_FROM=HOUSEOFPASHM <orders@YOUR_DOMAIN>
SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
SUPPORT_WHATSAPP_NUMBER=91XXXXXXXXXX

SELLER_LEGAL_NAME=YOUR_APPROVED_LEGAL_NAME
SELLER_POSTAL_ADDRESS=YOUR_APPROVED_POSTAL_ADDRESS
R2_PUBLIC_BASE_URL=https://YOUR_MEDIA_DOMAIN
